{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["community-token/src/**/*", "community-token/src/**/*.vue", "env.d.ts"],
  "exclude": ["community-token/src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.community-token.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ct/*": ["./community-token/src/*"],
      "@shared/*": ["./src/*"]
    }
  }
}
