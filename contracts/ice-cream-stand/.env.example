# Copy to .env in this directory — never commit .env
#
# cp .env.example .env

# Base mainnet RPC (pick one provider)
BASE_RPC_URL=https://mainnet.base.org

# Etherscan API V2 key — create at https://etherscan.io/myapikey (NOT basescan.org)
# Same key works for Base, Ethereum, etc. via the unified V2 API.
ETHERSCAN_API_KEY=

# Deployer — FYP Special Actions wallet (also contract owner after deploy)
# SPECIAL_ACTIONS_PRIVATE_KEY=0x...
